{
  "name": "fitness-app",
  "version": "0.1.0",
  "private": true,
  "description": "A production-minded fitness tracking application foundation.",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently --names web,api --prefix-colors cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev --workspace @fitness-app/web",
    "dev:api": "npm run dev --workspace @fitness-app/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.7"
  }
}
