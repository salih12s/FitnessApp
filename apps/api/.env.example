PORT=3001
FRONTEND_URL=http://localhost:3005
# MySQL format: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_SECURE=false
# Reverse proxies in front of the app (0 = none). Rate limits use the client IP
# from X-Forwarded-For, so set this to the real hop count in production.
TRUST_PROXY_HOPS=0
# Optional: meal photo analysis with Claude. The feature is off without a key.
# Every analysis is a paid API call; see docs/development.md.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# PHOTO_ANALYSIS_DAILY_LIMIT=15
# PHOTO_ANALYSIS_GLOBAL_DAILY_LIMIT=300
