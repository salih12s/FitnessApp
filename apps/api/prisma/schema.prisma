generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "mysql"
}

enum WeightUnit {
  kg
  lb
}

model User {
  id                String               @id @default(uuid()) @db.Char(36)
  username          String               @unique
  passwordHash      String               @map("password_hash")
  weightUnit        WeightUnit           @default(kg) @map("weight_unit")
  isCoach           Boolean              @default(false) @map("is_coach")
  coachInviteCode   String?              @unique @map("coach_invite_code") @db.VarChar(16)
  createdAt         DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  exercises         Exercise[]           @relation("CustomExerciseOwner")
  exerciseLogs      ExerciseLog[]
  exercisePrefs     ExercisePreference[]
  refreshSessions   RefreshSession[]
  workoutSessions   WorkoutSession[]
  workoutTemplates  WorkoutTemplate[]
  bodyMeasurements  BodyMeasurement[]
  coachLinks        CoachClient[]        @relation("CoachLinks")
  clientLinks       CoachClient[]        @relation("ClientLinks")
  enteredLogs       ExerciseLog[]        @relation("LogEnteredBy")
  assignedTemplates WorkoutTemplate[]    @relation("TemplateAssignedBy")

  @@map("users")
}

model RefreshSession {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model MuscleGroup {
  id        String     @id @default(uuid()) @db.Char(36)
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  exercises Exercise[]

  @@map("muscle_groups")
}

model Exercise {
  id                String               @id @default(uuid()) @db.Char(36)
  name              String
  slug              String
  slugNamespace     String               @default("global") @map("slug_namespace")
  description       String?              @db.Text
  equipment         String?
  imageUrl          String?              @map("image_url") @db.VarChar(2048)
  isCustom          Boolean              @default(false) @map("is_custom")
  createdByUserId   String?              @map("created_by_user_id") @db.Char(36)
  muscleGroupId     String               @map("muscle_group_id") @db.Char(36)
  createdAt         DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  createdByUser     User?                @relation("CustomExerciseOwner", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  muscleGroup       MuscleGroup          @relation(fields: [muscleGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  exerciseLogs      ExerciseLog[]
  preferences       ExercisePreference[]
  templateExercises TemplateExercise[]

  @@unique([slugNamespace, slug])
  @@index([createdByUserId])
  @@index([muscleGroupId])
  @@map("exercises")
}

/// Per-user library customization: a display name override or a hidden
/// (deleted from the user's library) marker. Workout history is unaffected.
model ExercisePreference {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  exerciseId String    @map("exercise_id") @db.Char(36)
  customName String?   @map("custom_name")
  hiddenAt   DateTime? @map("hidden_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  exercise   Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, exerciseId])
  @@index([exerciseId])
  @@map("exercise_preferences")
}

model ExerciseLog {
  id              String          @id @default(uuid()) @db.Char(36)
  userId          String          @map("user_id") @db.Char(36)
  exerciseId      String          @map("exercise_id") @db.Char(36)
  sessionId       String?         @map("session_id") @db.Char(36)
  /// Set when a coach entered the log for this user; null for own logs.
  enteredByUserId String?         @map("entered_by_user_id") @db.Char(36)
  performedAt     DateTime        @default(now()) @map("performed_at") @db.DateTime(3)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  exercise        Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  session         WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  enteredBy       User?           @relation("LogEnteredBy", fields: [enteredByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  exerciseSets    ExerciseSet[]

  @@index([userId, performedAt(sort: Desc)])
  @@index([userId, exerciseId, performedAt(sort: Desc)])
  @@index([exerciseId, performedAt(sort: Desc)])
  @@index([performedAt])
  @@index([sessionId])
  @@index([enteredByUserId])
  @@map("exercise_logs")
}

/// One visit to the gym. `endedAt` is null while the session is active; a
/// user has at most one active session (enforced in SessionsService).
model WorkoutSession {
  id           String           @id @default(uuid()) @db.Char(36)
  userId       String           @map("user_id") @db.Char(36)
  templateId   String?          @map("template_id") @db.Char(36)
  startedAt    DateTime         @default(now()) @map("started_at") @db.DateTime(3)
  endedAt      DateTime?        @map("ended_at") @db.DateTime(3)
  note         String?          @db.Text
  createdAt    DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  template     WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  exerciseLogs ExerciseLog[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([templateId])
  @@map("workout_sessions")
}

/// A reusable workout plan. `scheduledDays` is a weekday bitmask
/// (Monday = 1, Tuesday = 2, ... Sunday = 64) used by the calendar.
model WorkoutTemplate {
  id               String             @id @default(uuid()) @db.Char(36)
  userId           String             @map("user_id") @db.Char(36)
  name             String             @db.VarChar(80)
  scheduledDays    Int                @default(0) @map("scheduled_days")
  /// The coach who assigned (copied) this template to the user, if any.
  assignedByUserId String?            @map("assigned_by_user_id") @db.Char(36)
  createdAt        DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  user             User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedBy       User?              @relation("TemplateAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  exercises        TemplateExercise[]
  sessions         WorkoutSession[]

  @@index([userId])
  @@index([assignedByUserId])
  @@map("workout_templates")
}

/// One planned exercise in a template with its targets. Plan rows are not
/// history, so they go with their template or exercise.
model TemplateExercise {
  id             String          @id @default(uuid()) @db.Char(36)
  templateId     String          @map("template_id") @db.Char(36)
  exerciseId     String          @map("exercise_id") @db.Char(36)
  position       Int
  targetSets     Int             @map("target_sets")
  targetReps     Int             @map("target_reps")
  targetWeightKg Decimal?        @map("target_weight_kg") @db.Decimal(6, 2)
  template       WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  exercise       Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([templateId, position])
  @@index([exerciseId])
  @@map("template_exercises")
}

model ExerciseSet {
  id            String      @id @default(uuid()) @db.Char(36)
  exerciseLogId String      @map("exercise_log_id") @db.Char(36)
  setNumber     Int         @map("set_number")
  weightKg      Decimal     @map("weight_kg") @db.Decimal(6, 2)
  reps          Int
  createdAt     DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  exerciseLog   ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([exerciseLogId, setNumber])
  @@map("exercise_sets")
}

model BodyMeasurement {
  id             String   @id @default(uuid()) @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  measuredAt     DateTime @map("measured_at") @db.Date
  weightKg       Decimal? @map("weight_kg") @db.Decimal(5, 2)
  bodyFatPercent Decimal? @map("body_fat_percent") @db.Decimal(4, 1)
  waistCm        Decimal? @map("waist_cm") @db.Decimal(5, 1)
  chestCm        Decimal? @map("chest_cm") @db.Decimal(5, 1)
  armCm          Decimal? @map("arm_cm") @db.Decimal(5, 1)
  note           String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, measuredAt(sort: Desc)])
  @@map("body_measurements")
}

/// Permission for a coach to view a client's data and enter logs for them.
/// Links are not history, so they go with either account.
model CoachClient {
  id        String   @id @default(uuid()) @db.Char(36)
  coachId   String   @map("coach_id") @db.Char(36)
  clientId  String   @map("client_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  coach     User     @relation("CoachLinks", fields: [coachId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  client    User     @relation("ClientLinks", fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([coachId, clientId])
  @@index([clientId])
  @@map("coach_clients")
}
